# Public site origin — used to build absolute URLs in metadata, robots.ts, and
# sitemap.ts. Set to your deployed domain in production (origin only, no path —
# e.g. https://brizmarket.com).
NEXT_PUBLIC_APP_URL=https://myshop-landing.vercel.app

# Backend API base URL. A trailing slash is optional (custom-fetch normalizes it).
NEXT_PUBLIC_API_URL=https://myshopbackend.bytecare.xyz/api/v1
